{
  "info": {
    "_postman_id": "2f44b8a2-58f7-4a63-a012-7f11c324bbed",
    "name": "CampusCore Student Management API",
    "description": "End-to-end API scenarios. Run in collection order. Login saves {{token}}; POST requests save resource IDs for later requests. Expected success codes are asserted. Start locally at http://127.0.0.1:5000 and configure adminEmail/adminPassword before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [{
    "listen": "test",
    "script": {
      "type": "text/javascript",
      "exec": ["pm.test('Request succeeded', function () { pm.expect(pm.response.code).to.be.within(200, 299); });"]
    }
  }],
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "token", "value": "" },
    { "key": "departmentId", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "subjectId", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "attendanceId", "value": "" },
    { "key": "resultId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Create administrator account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('signupEmail', 'signup-' + Date.now() + '@example.com');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Administrator account created', function () { pm.response.to.have.status(201); });",
                  "pm.expect(pm.response.json().token).to.be.a('string');"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Campus Admin\",\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"secure-password-123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": [{
            "name": "201 Account created",
            "originalRequest": { "method": "POST", "url": "{{baseUrl}}/api/auth/register" },
            "status": "Created",
            "code": 201,
            "_postman_previewlanguage": "json",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "cookie": [],
            "body": "{\n  \"token\": \"<signed-token>\",\n  \"user\": { \"id\": 2, \"email\": \"signup@example.com\", \"full_name\": \"Postman Campus Admin\" }\n}"
          }]
        },
        {
          "name": "Login (saves token)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeds', function () { pm.response.to.have.status(200); });", "const body = pm.response.json();", "pm.expect(body.token).to.be.a('string');", "pm.collectionVariables.set('token', body.token);"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "response": [{
            "name": "200 Login success",
            "originalRequest": { "method": "POST", "url": "{{baseUrl}}/api/auth/login" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "json",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "cookie": [],
            "body": "{\n  \"token\": \"<signed-token>\",\n  \"user\": { \"id\": 1, \"email\": \"admin@example.com\", \"full_name\": \"System Administrator\" }\n}"
          }]
        },
        {
          "name": "Get current user",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Current user is authenticated', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('adminEmail'));"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] } }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "Create department",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Department created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('departmentId', pm.response.json().department.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Engineering\",\n  \"code\": \"ENG\",\n  \"description\": \"School of Engineering and Applied Sciences\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/departments", "host": ["{{baseUrl}}"], "path": ["api", "departments"] } }
        },
        {
          "name": "List departments",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Departments listed', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.json().departments).to.be.an('array');"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/departments", "host": ["{{baseUrl}}"], "path": ["api", "departments"] } }
        },
        {
          "name": "Get department",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Department found', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/departments/{{departmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "departments", "{{departmentId}}"] } }
        },
        {
          "name": "Update department",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Department updated', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Engineering, computing and applied sciences\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/departments/{{departmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "departments", "{{departmentId}}"] } }
        }
      ]
    },
    {
      "name": "Courses and subjects",
      "item": [
        {
          "name": "Create course",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Course created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('courseId', pm.response.json().course.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bachelor of Computer Science\",\n  \"code\": \"BCS\",\n  \"department_id\": {{departmentId}},\n  \"duration_years\": 4,\n  \"description\": \"Undergraduate computing program\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/courses", "host": ["{{baseUrl}}"], "path": ["api", "courses"] } }
        },
        {
          "name": "List courses",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Courses listed', function () { pm.response.to.have.status(200); });"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/courses?department_id={{departmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "courses"], "query": [{ "key": "department_id", "value": "{{departmentId}}" }] } }
        },
        {
          "name": "Get course",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/courses/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["api", "courses", "{{courseId}}"] } }
        },
        {
          "name": "Update course",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Computer science and software engineering\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/courses/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["api", "courses", "{{courseId}}"] } }
        },
        {
          "name": "Create subject",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Subject created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('subjectId', pm.response.json().subject.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"course_id\": {{courseId}},\n  \"name\": \"Introduction to Programming\",\n  \"code\": \"CS101\",\n  \"credits\": 4\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/subjects", "host": ["{{baseUrl}}"], "path": ["api", "subjects"] } }
        },
        {
          "name": "List subjects",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/subjects?course_id={{courseId}}", "host": ["{{baseUrl}}"], "path": ["api", "subjects"], "query": [{ "key": "course_id", "value": "{{courseId}}" }] } }
        },
        {
          "name": "Get subject",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/subjects/{{subjectId}}", "host": ["{{baseUrl}}"], "path": ["api", "subjects", "{{subjectId}}"] } }
        },
        {
          "name": "Update subject",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"credits\": 3\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/subjects/{{subjectId}}", "host": ["{{baseUrl}}"], "path": ["api", "subjects", "{{subjectId}}"] } }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create student",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('studentId', pm.response.json().student.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"student_id\": \"STU-2026-001\",\n  \"full_name\": \"Jordan Taylor\",\n  \"email\": \"jordan.taylor@example.edu\",\n  \"phone\": \"+1 555 010 2040\",\n  \"gender\": \"Prefer not to say\",\n  \"date_of_birth\": \"2005-04-18\",\n  \"address\": \"100 College Avenue\",\n  \"department_id\": {{departmentId}},\n  \"course_id\": {{courseId}},\n  \"year_of_study\": 1,\n  \"admission_date\": \"2026-08-15\",\n  \"status\": \"Active\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] } }
        },
        {
          "name": "List students (search and filters)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student list returned', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.json().students).to.be.an('array');"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/students?search=Jordan&department_id={{departmentId}}&course_id={{courseId}}&status=Active", "host": ["{{baseUrl}}"], "path": ["api", "students"], "query": [{ "key": "search", "value": "Jordan" }, { "key": "department_id", "value": "{{departmentId}}" }, { "key": "course_id", "value": "{{courseId}}" }, { "key": "status", "value": "Active" }] } }
        },
        {
          "name": "Get student profile",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student profile includes academic records', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.json().student).to.have.property('student_id');"] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] } },
          "response": [{
            "name": "200 Student profile",
            "originalRequest": { "method": "GET", "url": "{{baseUrl}}/api/students/1" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "json",
            "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"student\": {\n    \"id\": 1,\n    \"student_id\": \"STU-2026-001\",\n    \"full_name\": \"Jordan Taylor\",\n    \"email\": \"jordan.taylor@example.edu\",\n    \"department_name\": \"Engineering\",\n    \"course_name\": \"Bachelor of Computer Science\",\n    \"attendance\": [],\n    \"results\": []\n  }\n}"
          }]
        },
        {
          "name": "Update student",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"year_of_study\": 2,\n  \"phone\": \"+1 555 010 2041\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] } }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Create attendance record",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Attendance created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('attendanceId', pm.response.json().attendance.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"student_id\": {{studentId}},\n  \"attendance_date\": \"2026-10-29\",\n  \"status\": \"Present\",\n  \"notes\": \"Postman API test\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/attendance", "host": ["{{baseUrl}}"], "path": ["api", "attendance"] } }
        },
        {
          "name": "List attendance (date and status)",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/attendance?date=2026-10-29&status=Present", "host": ["{{baseUrl}}"], "path": ["api", "attendance"], "query": [{ "key": "date", "value": "2026-10-29" }, { "key": "status", "value": "Present" }] } }
        },
        {
          "name": "Get attendance record",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/attendance/{{attendanceId}}", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "{{attendanceId}}"] } }
        },
        {
          "name": "Update attendance record",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"Late\",\n  \"notes\": \"Arrived after class started\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/attendance/{{attendanceId}}", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "{{attendanceId}}"] } }
        },
        {
          "name": "Delete attendance record",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/attendance/{{attendanceId}}", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "{{attendanceId}}"] } }
        }
      ]
    },
    {
      "name": "Results",
      "item": [
        {
          "name": "Create result",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Result created and grade calculated', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().result.grade).to.eql('A'); });", "pm.collectionVariables.set('resultId', pm.response.json().result.id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"student_id\": {{studentId}},\n  \"subject_id\": {{subjectId}},\n  \"academic_year\": \"2026-2027\",\n  \"score\": 94,\n  \"max_score\": 100\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/results", "host": ["{{baseUrl}}"], "path": ["api", "results"] } }
        },
        {
          "name": "List results",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/results?student_id={{studentId}}&subject_id={{subjectId}}", "host": ["{{baseUrl}}"], "path": ["api", "results"], "query": [{ "key": "student_id", "value": "{{studentId}}" }, { "key": "subject_id", "value": "{{subjectId}}" }] } }
        },
        {
          "name": "Get result",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/results/{{resultId}}", "host": ["{{baseUrl}}"], "path": ["api", "results", "{{resultId}}"] } }
        },
        {
          "name": "Update result",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"score\": 96\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/results/{{resultId}}", "host": ["{{baseUrl}}"], "path": ["api", "results", "{{resultId}}"] } }
        },
        {
          "name": "Delete result",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/results/{{resultId}}", "host": ["{{baseUrl}}"], "path": ["api", "results", "{{resultId}}"] } }
        }
      ]
    },
    {
      "name": "Dashboard, reports and cleanup",
      "item": [
        {
          "name": "Dashboard statistics",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Dashboard statistics returned', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.json().stats).to.have.property('total_students');"] } }],
