            "status": "OK", "code": 200, "_postman_previewlanguage": "json",
            "header": [{ "key": "Content-Type", "value": "application/json" }], "cookie": [],
            "body": "{\n  \"stats\": { \"total_students\": 1, \"active_students\": 1, \"total_departments\": 1, \"total_courses\": 1, \"average_score\": 94.0 },\n  \"attendance\": [{ \"status\": \"Present\", \"count\": 1 }],\n  \"admissions\": [],\n  \"recent_admissions\": []\n}"
          }]
        },
        {
          "name": "Export student report CSV",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('CSV report downloads', function () { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "text/csv" }], "url": { "raw": "{{baseUrl}}/api/reports/students.csv", "host": ["{{baseUrl}}"], "path": ["api", "reports", "students.csv"] } },
          "response": [{
            "name": "200 CSV report",
            "originalRequest": { "method": "GET", "url": "{{baseUrl}}/api/reports/students.csv" },
            "status": "OK", "code": 200, "_postman_previewlanguage": "text",
            "header": [{ "key": "Content-Type", "value": "text/csv" }], "cookie": [],
            "body": "Student ID,Full Name,Email,Phone,Gender,Date of Birth,Department,Course,Year of Study,Admission Date,Status"
          }]
        },
        {
          "name": "Delete student",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] } }
        },
        {
          "name": "Delete subject",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/subjects/{{subjectId}}", "host": ["{{baseUrl}}"], "path": ["api", "subjects", "{{subjectId}}"] } }
        },
